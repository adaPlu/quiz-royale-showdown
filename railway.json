{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --prefix railway-api && npm run build --prefix railway-api"
  },
  "deploy": {
    "startCommand": "npm start --prefix railway-api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
